local player = game:GetService("Players").LocalPlayer
local camera = game:GetService("Workspace").CurrentCamera
local runService = game:GetService("RunService")
local userInput = game:GetService("UserInputService")
local playerList = game:GetService("Players")
local lighting = game:GetService("Lighting")

local espEnabled = true
local silentAimEnabled = true
local adminPanelVisible = false
local aimPart = "Head"
local espTable = {}

local function createESP(plr)
if plr == player or espTable[plr] then return end
local char = plr.Character
if not char or not char.PrimaryPart then return end
local gui = Instance.new("BillboardGui")
gui.Name = "ESP_" .. plr.Name
gui.Size = UDim2.new(0, 120, 0, 160)
gui.StudsOffset = Vector3.new(0, 3, 0)
gui.AlwaysOnTop = true
local frame = Instance.new("Frame")
frame.Size = UDim2.new(1, 0, 1, 0)
frame.BackgroundTransparency = 0.5
frame.BackgroundColor3 = plr.Team and plr.Team.TeamColor.Color or Color3.new(0, 1, 0)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.new(1, 1, 1)
frame.Parent = gui
local nameLabel = Instance.new("TextLabel")
nameLabel.Size = UDim2.new(1, 0, 0.25, 0)
nameLabel.Position = UDim2.new(0, 0, 0.75, 0)
nameLabel.BackgroundTransparency = 1
nameLabel.Text = plr.Name
nameLabel.TextColor3 = Color3.new(1, 1, 1)
nameLabel.TextScaled = true
nameLabel.Font = Enum.Font.SourceSansBold
nameLabel.Parent = gui
local healthBar = Instance.new("Frame")
healthBar.Size = UDim2.new(1, 0, 0.1, 0)
healthBar.Position = UDim2.new(0, 0, 0.65, 0)
healthBar.BackgroundColor3 = Color3.new(1, 0, 0)
healthBar.BorderSizePixel = 0
healthBar.Parent = gui
local healthFill = Instance.new("Frame")
healthFill.Size = UDim2.new(1, 0, 1, 0)
healthFill.BackgroundColor3 = Color3.new(0, 1, 0)
healthFill.BorderSizePixel = 0
healthFill.Parent = healthBar
gui.Parent = char.PrimaryPart
espTable[plr] = gui
spawn(function()
while gui and gui.Parent do
task.wait(0.5)
local humanoid = char:FindFirstChild("Humanoid")
if humanoid then
local h = humanoid.Health / humanoid.MaxHealth
healthFill.Size = UDim2.new(h, 0, 1, 0)
healthFill.BackgroundColor3 = h > 0.5 and Color3.new(0,1,0) or h > 0.25 and Color3.new(1,1,0) or Color3.new(1,0,0)
end
end
end)
end

local function removeESP(plr)
if espTable[plr] then espTable[plr]:Destroy() espTable[plr] = nil end
end

local function refreshESP()
for plr in pairs(espTable) do
if not plr.Parent or not plr.Character or not plr.Character.PrimaryPart then removeESP(plr) end
end
for _, plr in pairs(playerList:GetPlayers()) do
if plr ~= player and not espTable[plr] then createESP(plr) end
end
end

local function getClosestPlayer()
local closest, closestDist = nil, math.huge
local origin, dir = camera.CFrame.Position, camera.CFrame.LookVector
for _, plr in pairs(playerList:GetPlayers()) do
if plr ~= player and plr.Character and plr.Character.PrimaryPart then
local pos = plr.Character.PrimaryPart.Position
local sp, on = camera:WorldToScreenPoint(pos)
if on then
local dist = (pos - origin).Magnitude
local vec = (pos - origin).Unit
if dir:Dot(vec) > 0.85 and dist < closestDist then
closest, closestDist = plr, dist
end
end
end
end
return closest
end

local function silentAim()
if not silentAimEnabled then return end
local target = getClosestPlayer()
if target and target.Character then
local part = target.Character:FindFirstChild(aimPart) or target.Character.PrimaryPart
if part then
camera.CFrame = CFrame.new(camera.CFrame.Position, part.Position)
end
end
end

