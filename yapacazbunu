closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.TextScaled = true
closeBtn.Font = Enum.Font.SourceSansBold
closeBtn.Parent = mf
closeBtn.MouseButton1Click:Connect(function() mf.Visible = false adminPanelVisible = false end)
userInput.InputBegan:Connect(function(input, isTyping)
if isTyping then return end
if input.KeyCode == Enum.KeyCode.Insert then
adminPanelVisible = not adminPanelVisible
mf.Visible = adminPanelVisible
end
end)
end

playerList.PlayerAdded:Connect(function(plr)
plr.CharacterAdded:Connect(function(char)
char:WaitForChild("PrimaryPart")
task.wait(0.5)
if espEnabled then createESP(plr) end
end)
end)
playerList.PlayerRemoving:Connect(removeESP)

runService.Heartbeat:Connect(function()
if espEnabled then refreshESP() end
if silentAimEnabled then silentAim() end
end)

lighting.Brightness = 2
lighting.Ambient = Color3.new(1,1,1)
lighting.OutdoorAmbient = Color3.new(1,1,1)

task.wait(1)
for _, plr in pairs(playerList:GetPlayers()) do
if plr ~= player then createESP(plr) end
end
createAdminPanel()
